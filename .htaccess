RewriteEngine On

# Impede a listagem de diretórios por segurança
Options -Indexes

# Descomente e ajuste a linha abaixo se o servidor de produção exigir uma base específica
# RewriteBase /

# Se o arquivo ou diretório solicitado existir fisicamente, acesse-o diretamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Caso contrário, redirecione tudo para o index.php
RewriteRule ^(.*)$ index.php [L,QSA]
